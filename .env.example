# Copy to .env and fill in. Never commit .env.

# --- Model ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high            # low | medium | high | xhigh | max
ANTHROPIC_FALLBACK_MODEL=claude-sonnet-5-5   # tried once per case if the primary model keeps failing
ANTHROPIC_SERVER_FALLBACKS=1     # 1 = retry on fallback model if a safety refusal occurs

# --- Provider selection ---
# auto = anthropic if ANTHROPIC_API_KEY is set, else mock
LLM_PROVIDER=auto

# --- Tools ---
# mock = local JSON environment in data/mock_env ; http = event-provided APIs
TOOL_BACKEND=mock
TOOLS_BASE_URL=
TOOLS_API_KEY=

# --- Voice (optional) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
VOICE_LIVE_CALLS=0               # 1 = place real outbound calls; 0 = simulate

# --- Runner ---
RUN_WORKERS=6
CASE_TIMEOUT_SECONDS=600
MAX_AGENT_STEPS=30
